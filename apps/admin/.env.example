# Supabase (shared project). The admin runs on the user's session — only the
# public values are needed at runtime. The service-role key stays out of the
# admin app (server-side provisioning lands in R7 and uses it then).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # publishable key — low privilege, browser-safe
