# --- Supabase (shared project; single set of secrets — RLS-by-tenant model) ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # publishable (or legacy anon) key — low privilege, browser-safe
SUPABASE_SERVICE_ROLE_KEY=              # SERVER ONLY — never in a client bundle. Bypasses RLS.
SUPABASE_PROJECT_REF=                   # for `gen:types` / `link`
# Migration/CI secrets (NOT app runtime): SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD

# --- Tenant binding for the public build (one Vercel project per client) ---
TENANT_SLUG=                            # build-time tenant slug for apps/web
TENANT_ID=                              # tenant uuid used by the data-layer scoping helper

# Site identity
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME="vetkit (dev)"
NEXT_PUBLIC_DEFAULT_LOCALE=tr-TR

# Template selection: modern | classic | premium
TEMPLATE=modern

# Email (Resend)
RESEND_API_KEY=
CLINIC_EMAIL=
CONTACT_FROM_EMAIL=

# --- Sanity (LEGACY — removed when the Supabase rebuild lands (R4/R8). Kept so
#     the app keeps building while lib/sanity/* still exists. Do not delete yet. ---
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=
# SANITY_REVALIDATE_SECRET=
