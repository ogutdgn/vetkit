{
  "name": "@vetkit/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./types": "./src/database.types.ts",
    "./schemas": "./src/schemas.ts"
  },
  "files": [
    "src",
    "supabase"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" --schema public > src/database-generated.types.ts",
    "db:link": "supabase --workdir . link --project-ref \"$SUPABASE_PROJECT_REF\"",
    "db:push:dry": "supabase --workdir . db push --linked --dry-run",
    "db:push": "supabase --workdir . db push --linked",
    "db:test": "supabase --workdir . test db"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vetkit/config-typescript": "workspace:*",
    "supabase": "2.106.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "type-fest": "^5.7.0",
    "zod": "^4.4.3"
  }
}
